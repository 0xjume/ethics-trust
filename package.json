{
  "name": "keyless-trust",
  "private": true,
  "version": "0.1.0",
  "description": "Keyless Trust — NEAR-owned Solana raise vaults",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "test": "pnpm --filter @keyless-trust/relayer test && pnpm --filter @keyless-trust/ui test && pnpm --filter @keyless-trust/app test",
    "build:ui": "pnpm --filter @keyless-trust/ui build",
    "derive-addresses": "pnpm --filter @keyless-trust/relayer derive-addresses",
    "deposit-address": "pnpm --filter @keyless-trust/relayer deposit-address",
    "deploy-testnet": "pnpm --filter @keyless-trust/relayer deploy-testnet",
    "dbc-tx-size": "pnpm --filter @keyless-trust/relayer dbc-tx-size",
    "verify-dbc-sdk": "pnpm --filter @keyless-trust/relayer verify-dbc-sdk",
    "create-dbc-config": "pnpm --filter @keyless-trust/relayer create-dbc-config",
    "build-launch-message": "pnpm --filter @keyless-trust/relayer build-launch-message",
    "request-launch": "pnpm --filter @keyless-trust/relayer request-launch",
    "relay-launch": "pnpm --filter @keyless-trust/relayer relay-launch",
    "confirm-launch": "pnpm --filter @keyless-trust/relayer confirm-launch",
    "generate-quote-fixtures": "pnpm --filter @keyless-trust/relayer generate-quote-fixtures",
    "build-distribute-message": "pnpm --filter @keyless-trust/relayer build-distribute-message",
    "request-distribute": "pnpm --filter @keyless-trust/relayer request-distribute",
    "relay-distribute": "pnpm --filter @keyless-trust/relayer relay-distribute",
    "confirm-distribute": "pnpm --filter @keyless-trust/relayer confirm-distribute",
    "dev:app": "pnpm --filter @keyless-trust/app dev"
  }
}
