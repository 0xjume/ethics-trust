# Copy to .env locally. Never commit secrets.
# Testnet / Solana devnet only. Do not use mainnet keys.

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# Predecessor used for derived_public_key (does not need to exist for the view).
NEAR_PREDECESSOR=example.testnet
MPC_CONTRACT=v1.signer-prod.testnet
TRUST_ID=1
CONTRIBUTOR_SOLANA_PUBKEY=B4paagQ87U6kmpn3AoXYaZMQVsFCJbZtjh8tBoKDDXwj
# Deployed Trust contract (optional). deposit-address uses the on-chain view when set.
CONTRACT_ID=
# Subaccount label under NEAR_ACCOUNT_ID. Default m2 → m2.keyless-trust-dev-54ef71.testnet
DEPLOY_SUBACCOUNT=m4
# Override storage deposit (NEAR). Default is max(5.5, wasm/100KiB + 0.5).
DEPLOY_NEAR=
# Set to 1 to actually create the subaccount and deploy (testnet only).
EXECUTE_DEPLOY=
# Set to 1 to leave the parent full-access key on the contract (off by default).
DEPLOY_KEEP_KEY=

SOLANA_RPC_URL=https://api.devnet.solana.com
# Local Solana fee-payer keypair (JSON secret-key array). Never the vault.
# Needed only for the e2e script. Do not commit the file.
SOLANA_RELAYER_KEYPAIR=
# Destination for the NEAR-signed transfer script.
SOLANA_TRANSFER_TO=
SOLANA_TRANSFER_LAMPORTS=5000
# Attached gas for a direct MPC sign (default 30). Live burn was 8.84 TGas.
MPC_SIGN_TGAS=30
# Set to 1 to send the assembled Solana tx after local verify.
SOLANA_SUBMIT=
